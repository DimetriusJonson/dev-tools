{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebDev Useful Tools",
  "identifier": "com.shz.app.WebDevUsefulTools",
  "build": {
    "beforeDevCommand": "cargo leptos watch",
    "devUrl": "http://localhost:3000",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "../site/pkg/",
      "../site/codemirror.min.js"
    ],
    "externalBin": [
      "binaries/webdev_useful_tools_server"
    ]
  }
}
